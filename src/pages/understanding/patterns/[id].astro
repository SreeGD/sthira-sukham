---
import { withBase } from '../../../lib/paths.ts';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SourceList from '../../../components/SourceList.astro';
import { getCollection, getEntries, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('stiffnessPatterns');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const involved = entry.data.typicallyInvolves.length
  ? await getEntries(entry.data.typicallyInvolves)
  : [];
const related = entry.data.relatedSources.length
  ? await getEntries(entry.data.relatedSources)
  : [];
---
<BaseLayout title={entry.data.name} description={`${entry.data.name} — a general description.`}>
  <p><a href={withBase('/understanding/patterns/')}>← Stiffness patterns</a></p>
  <h1>{entry.data.name}</h1>
  <div class="prose"><Content /></div>

  {related.length > 0 && (
    <section class="section">
      <h2>Underlying sources of stiffness</h2>
      <ul class="grid">
        {related.map((s) => (
          <li><a class="card" href={withBase(`/understanding/sources/${s.id}/`)}><strong>{s.data.clinicalTerm}</strong></a></li>
        ))}
      </ul>
    </section>
  )}

  {involved.length > 0 && (
    <section class="section">
      <h2>Structures typically involved</h2>
      <ul class="grid">
        {involved.map((m) => (
          <li>
            <a class="card" href={withBase(`/muscles/${m.id}/`)}>
              <strong>{m.data.anatomicalName}</strong>
              <p class="card__traditional">{m.data.commonName}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <SourceList refs={entry.data.sources} />
</BaseLayout>
