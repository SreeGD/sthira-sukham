---
import { withBase } from '../../lib/paths.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { inWords } from '../../lib/numbers.ts';
import MuscleActionMap from '../../components/diagrams/MuscleActionMap.astro';

const joints = (await getCollection('joints')).sort((a, b) => a.data.order - b.data.order);
/* The knee's six only. This overview section names them as the knee's, and listing all
   24 under that heading showed "Capsular restriction" four times with nothing to tell
   the entries apart. The full set, grouped by joint, is on /understanding/sources/. */
const sources = (await getCollection('stiffnessSources'))
  .filter((s) => s.data.joint.id === 'knee')
  .sort((a, b) => a.data.order - b.data.order);
const patterns = (await getCollection('stiffnessPatterns'))
  .filter((p) => p.data.joint.id === 'knee')
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Understanding stiffness" description="How the knee works and why it stiffens.">
  <h1>Understanding stiffness</h1>
  <p class="lede">
    "Stiff" is a single word covering at least six physically different situations. Which one you
    have determines what helps — so it is worth knowing what they are.
  </p>

  <section class="section">
    <h2>The {inWords(joints.length)} joints</h2>
    <p>
      Each has its own mechanics, its own reasons for stiffening, and its own patterns — and each
      changes what the others have to do.
    </p>
    <ul class="grid">
      {
        joints.map((j) => (
          <li>
            <a class="card stack" href={withBase(`/joints/${j.id}/`)}>
              <h3>{j.data.name}</h3>
              <p>{j.data.plainDescription}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <h2>Every muscle that acts on the knee, and what it does</h2>
    <p>
      One picture of the whole system. Ten regions, what each does to the knee, and — the point
      worth noticing — how many of them are not at the knee at all.
    </p>
    <MuscleActionMap />
  </section>

  <section class="section">
    <h2><a href={withBase('/understanding/mechanics/')}>How the knee moves</a></h2>
    <p>
      Two joints rather than one, what a locked knee actually is, and how much bending everyday
      activities need.
    </p>
  </section>

  <section class="section">
    <h2><a href={withBase('/understanding/sources/')}>The six sources of stiffness</a></h2>
    <p>
      The same six mechanisms recur at every joint. These are the knee's; each joint page
      carries its own.
    </p>
    <ul class="grid">
      {sources.map((s) => (
        <li>
          <a class="card stack" href={withBase(`/understanding/sources/${s.id}/`)}>
            <h3>{s.data.clinicalTerm}</h3>
            <p>{s.data.plainLanguageGloss}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section">
    <h2>Commonly described patterns</h2>
    <p>
      These are general descriptions of presentations that get discussed a lot. They are not a
      checklist to sort yourself into — working out which applies to a particular knee is a
      clinical judgement, and a fairly straightforward one for a clinician to make.
    </p>
    <ul class="grid">
      {patterns.map((p) => (
        <li>
          <a class="card" href={withBase(`/understanding/patterns/${p.id}/`)}>
            <h3>{p.data.name}</h3>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
