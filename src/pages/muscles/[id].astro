---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceList from '../../components/SourceList.astro';
import LegLocator from '../../components/diagrams/LegLocator.astro';
import ExerciseCard from '../../components/ExerciseCard.astro';
import RedFlagGate from '../../components/RedFlagGate.astro';
import ClinicianFraming from '../../components/ClinicianFraming.astro';
import { getCollection, render } from 'astro:content';
import { buildMuscleExerciseIndex, exercisesForMuscle } from '../../lib/cross-links.ts';

export async function getStaticPaths() {
  const entries = await getCollection('muscles');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const allExercises = await getCollection('exercises');
const index = buildMuscleExerciseIndex(
  allExercises.map((e) => ({ id: e.id, targets: e.data.targets.map((t) => t.id), entry: e })),
);
const targeting = exercisesForMuscle(index, entry.id).map((x) => x.entry);
---
<BaseLayout title={d.anatomicalName} description={d.plainLanguageGloss}>
  <p><a href="/muscles/">← Muscles &amp; structures</a></p>

  <h1>{d.anatomicalName}</h1>
  <p class="lede">{d.plainLanguageGloss}</p>

  <p class="tag-row">
    <span class="tag">{d.commonName}</span>
    {d.abbreviations.map((a) => <span class="tag">{a}</span>)}
    <span class="tag">{d.region}</span>
    {!d.isContractile && <span class="tag">not a muscle — passive tissue</span>}
  </p>

  <section class="section muscle-intro">
    <div>
      <h2>What it does at the knee</h2>
      <p>{d.roleInKneeMotion}</p>
    </div>
    <LegLocator zone={d.diagramZone} name={d.anatomicalName} />
  </section>

  {d.presentsAsKneeStiffness && (
    <section class="section">
      <div class="callout">
        <h2>How this shows up as knee stiffness</h2>
        <p>{d.presentsAsKneeStiffness}</p>
      </div>
    </section>
  )}

  <section class="section">
    <h2>How it contributes to stiffness</h2>
    <dl class="definition-list">
      <dt>When it is tight</dt>
      <dd>{d.stiffnessContribution.whenTight}</dd>
      {d.stiffnessContribution.whenWeak && (<><dt>When it is weak</dt><dd>{d.stiffnessContribution.whenWeak}</dd></>)}
      {d.stiffnessContribution.whenInhibited && (<><dt>When it is inhibited</dt><dd>{d.stiffnessContribution.whenInhibited}</dd></>)}
    </dl>
  </section>

  <section class="section prose"><Content /></section>

  {/*
    Partial gate (contracts/routes.md). Everything above is educational and never gated —
    it makes no recommendation. Only the exercise list below is exercise content reached
    without passing through /exercises/, so only it sits behind the gate.
  */}
  <section class="section" id="exercises">
    <h2>Movements that target this</h2>
    {targeting.length === 0 ? (
      <p>{d.noExercisesNote}</p>
    ) : (
      <>
        <RedFlagGate />
        <div class="gated" data-testid="muscle-exercise-list">
          <ClinicianFraming />
          <ul class="grid">
            {targeting.map((e) => (
              <ExerciseCard
                id={e.id}
                name={e.data.name}
                traditionalName={e.data.traditionalName}
                modality={e.data.modality}
                difficulty={e.data.difficulty}
                equipment={e.data.equipment}
                startPosition={e.data.startPosition}
                evidenceLabel={e.data.evidenceLabel}
              />
            ))}
          </ul>
        </div>
      </>
    )}
  </section>

  <SourceList refs={d.sources} />
</BaseLayout>
