---
import { withBase } from '../../lib/paths.ts';
import GatedLayout from '../../layouts/GatedLayout.astro';
import { getCollection } from 'astro:content';
const all = (await getCollection('routines')).sort((a, b) => a.data.order - b.data.order);
const routines = all.filter((r) => !r.data.goal);
const goalRoutines = all.filter((r) => r.data.goal);
---
<GatedLayout
  title="Routines"
  heading="Routines"
  lede="Three sequences assembled from the exercise library, each with the reasoning behind its order. They are examples of how movements fit together, not programmes prescribed for you."
  description="Ready-made sequences with the reasoning behind their order."
>
  <ul class="grid">
    {routines.map((r) => (
      <li>
        <a class="card stack" href={withBase(`/routines/${r.id}/`)}>
          <h2>{r.data.title}</h2>
          <p>{r.data.purpose}</p>
          <p class="tag-row">
            <span class="tag">about {r.data.approxDurationMinutes} min</span>
            <span class="tag">{r.data.steps.length} movements</span>
          </p>
        </a>
      </li>
    ))}
  </ul>
  <section class="section">
    <h2>Sessions for a specific goal</h2>
    <p>
      Half-hour sessions tied to something you want to be able to do again. Each explains what
      that activity asks of a knee — see <a href={withBase('/start/')}>where to start</a>.
    </p>
    <ul class="grid">
      {
        goalRoutines.map((r) => (
          <li>
            <a class="card stack" href={withBase(`/routines/${r.id}/`)}>
              <h3>{r.data.title}</h3>
              <p>{r.data.purpose}</p>
              <p class="tag-row">
                <span class="tag">about {r.data.approxDurationMinutes} min</span>
                <span class="tag">{r.data.steps.length} movements</span>
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</GatedLayout>
