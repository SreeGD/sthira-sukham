---
import GatedLayout from '../../layouts/GatedLayout.astro';
import SourceList from '../../components/SourceList.astro';
import EvidenceBadge from '../../components/EvidenceBadge.astro';
import ExerciseAtAGlance from '../../components/ExerciseAtAGlance.astro';
import VideoSearchLink from '../../components/VideoSearchLink.astro';
import { getCollection, getEntries, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('exercises');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const [targets, regressions, progressions, label] = await Promise.all([
  getEntries(d.targets),
  d.regressions.length ? getEntries(d.regressions) : Promise.resolve([]),
  d.progressions.length ? getEntries(d.progressions) : Promise.resolve([]),
  getEntry(d.evidenceLabel),
]);

const MODALITY_LABEL: Record<string, string> = {
  'clinical-rom': 'Clinical range of motion',
  yoga: 'Yoga',
  pilates: 'Pilates',
  'taichi-qigong': 'Tai chi / qigong',
};
const GOAL_LABEL: Record<string, string> = {
  mobility: 'Mobility',
  strength: 'Strength',
  'motor-control': 'Motor control',
};
const kit = d.equipment.filter((e) => e !== 'none');

const EQUIPMENT_LABEL: Record<string, string> = {
  wall: 'a wall',
  chair: 'a chair',
  towel: 'a towel',
  cushion: 'a cushion or folded blanket',
  strap: 'a strap, belt or long towel',
  'resistance-band': 'a resistance band',
  'stationary-bike': 'a stationary bike',
  reformer: 'a reformer',
};

/* Zones come from the targets, deduplicated and capped: lighting up six regions
   communicates less than lighting up two. */
const feelZones = [...new Set(targets.map((m) => m.data.diagramZone))].slice(0, 3);
---
<GatedLayout
  title={d.name}
  heading={d.name}
  description={`${d.name} — ${MODALITY_LABEL[d.modality]}`}
>
  {d.traditionalName && (
    <p class="lede">
      <em>{d.traditionalName}</em>{d.tradition && <> — {d.tradition}</>}
    </p>
  )}

  <p class="tag-row">
    <span class="tag">{MODALITY_LABEL[d.modality] ?? d.modality}</span>
    {d.goal.map((g) => <span class="tag">{GOAL_LABEL[g] ?? g}</span>)}
    <span class="tag">{d.difficulty}</span>
    <span class="tag">{kit.length === 0 ? 'no equipment' : kit.join(', ')}</span>
    <EvidenceBadge ref={d.evidenceLabel} />
  </p>

  {label && (
    <p class="prose"><small>“{label.data.label}” means: {label.data.definition}</small></p>
  )}

  <ExerciseAtAGlance
    quickSteps={d.quickSteps}
    keyPoint={d.keyPoint}
    feelItIn={d.feelItIn}
    commonMistake={d.commonMistake}
    position={d.startPosition}
    feelZones={feelZones}
    name={d.name}
  />

  <section class="section">
    <h2>How to perform it correctly</h2>
    <p class="needs">
      <strong>Before you start:</strong>{' '}
      {
        kit.length === 0
          ? 'nothing to gather — this needs no equipment.'
          : `gather ${kit.map((k) => EQUIPMENT_LABEL[k] ?? k).join(', ').toLowerCase()}.`
      }
      {d.props.length > 0 && <> {d.props.join(' ')}</>}
    </p>
    <ol class="steps steps--labelled">
      {
        d.instructions.map((step) => (
          <li>
            <strong>{step.label}:</strong> {step.detail}
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section">
    <h2>Recommended routine</h2>
    <p class="prose">
      Typical starting figures as they are commonly described. They are a general starting
      point, not a prescription — what suits your knee is a question for a clinician.
    </p>
    <dl class="routine">
      <div><dt>Repetitions</dt><dd>{d.dosage.reps}</dd></div>
      <div><dt>Sets</dt><dd>{d.dosage.sets}</dd></div>
      <div><dt>Frequency</dt><dd>{d.dosage.frequency}</dd></div>
      {d.dosage.hold && (<div><dt>Hold</dt><dd>{d.dosage.hold}</dd></div>)}
    </dl>
    {d.dosage.note && <p class="routine__note">{d.dosage.note}</p>}
  </section>

  {d.modifications.length > 0 && (
    <section class="section">
      <h2>Modifications for a restricted knee</h2>
      <ul>{d.modifications.map((m) => <li>{m}</li>)}</ul>
      {d.props.length > 0 && (
        <>
          <h3>Props that help</h3>
          <ul>{d.props.map((p) => <li>{p}</li>)}</ul>
        </>
      )}
    </section>
  )}

  {/* FR-006. These two are why this exercise is allowed to exist at all. */}
  <section class="section">
    <div class="danger-list">
      <h3>Do not do this if</h3>
      <ul>{d.contraindications.map((c) => <li>{c}</li>)}</ul>
      <h3>Stop if</h3>
      <ul>{d.stopIf.map((s) => <li>{s}</li>)}</ul>
    </div>
  </section>

  <section class="section prose">
    <h2>What is actually happening</h2>
    <Content />
  </section>

  <section class="section" data-testid="exercise-targets">
    <h2>What this targets</h2>
    <ul class="grid">
      {targets.map((m) => (
        <li>
          <a class="card" href={`/muscles/${m.id}/`}>
            <strong>{m.data.anatomicalName}</strong>
            <p class="card__traditional">{m.data.commonName}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {(regressions.length > 0 || progressions.length > 0) && (
    <section class="section">
      <h2>If this is too hard or too easy</h2>
      {regressions.length > 0 && (
        <>
          <h3>Easier</h3>
          <ul class="grid">
            {regressions.map((e) => (
              <li><a class="card" href={`/exercises/${e.id}/`}><strong>{e.data.name}</strong></a></li>
            ))}
          </ul>
        </>
      )}
      {progressions.length > 0 && (
        <>
          <h3>Harder</h3>
          <ul class="grid">
            {progressions.map((e) => (
              <li><a class="card" href={`/exercises/${e.id}/`}><strong>{e.data.name}</strong></a></li>
            ))}
          </ul>
        </>
      )}
    </section>
  )}

  <VideoSearchLink exercise={{ name: d.name, traditionalName: d.traditionalName, modality: d.modality }} />

  <SourceList refs={d.sources} />
</GatedLayout>
