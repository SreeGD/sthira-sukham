---
import { videoSearchUrl, type VideoSearchable } from '../lib/video-search.ts';

/*
 * Deliberately framed as a search, not a recommendation. See src/lib/video-search.ts
 * for why this project does not link specific videos.
 */

interface Props {
  exercise: VideoSearchable;
}
const { exercise } = Astro.props;
const url = videoSearchUrl(exercise);
---

<aside class="video-search">
  <p>
    <a href={url} target="_blank" rel="noopener noreferrer nofollow">
      Search YouTube for demonstrations of this movement
      <span aria-hidden="true">↗</span>
      <span class="visually-hidden">(opens in a new tab)</span>
    </a>
  </p>
  <p class="video-search__note">
    This opens a search on YouTube — a third-party site, outside this reference. Nothing here
    is vetted or endorsed, quality varies widely, and any demonstration you find may differ
    from the instructions above. The cautions on this page still apply.
  </p>
</aside>

<style>
  .video-search {
    margin-top: var(--s-5);
    padding: var(--s-3) var(--s-4);
    border: 1px dashed var(--c-border-strong);
    border-radius: var(--radius);
    background: var(--c-surface-sunken);
  }
  .video-search p {
    margin: 0;
    max-width: var(--measure);
  }
  .video-search a {
    font-weight: 600;
  }
  .video-search__note {
    margin-top: var(--s-2);
    font-size: var(--f-size-sm);
    color: var(--c-text-muted);
  }
</style>
