---
import { withBase } from '../lib/paths.ts';
import EvidenceBadge from './EvidenceBadge.astro';
import PositionFigure from './diagrams/PositionFigure.astro';
import type { StartPosition } from '../lib/positions.ts';

const MODALITY_LABEL: Record<string, string> = {
  'clinical-rom': 'Range of motion',
  yoga: 'Yoga',
  pilates: 'Pilates',
  'taichi-qigong': 'Tai chi / qigong',
};

interface Props {
  id: string;
  name: string;
  traditionalName?: string;
  modality: string;
  difficulty: string;
  equipment: string[];
  startPosition: StartPosition;
  evidenceLabel: { collection: 'evidenceLabels'; id: string };
}
const { id, name, traditionalName, modality, difficulty, equipment, startPosition, evidenceLabel } =
  Astro.props;
const needsKit = equipment.filter((e) => e !== 'none');
---

<li>
  <a class="card stack" href={withBase(`/exercises/${id}/`)}>
    <h3>{name}</h3>
    {traditionalName && <p class="card__traditional">{traditionalName}</p>}
    <p class="tag-row">
      <span class="tag">{MODALITY_LABEL[modality] ?? modality}</span>
      <span class="tag">{difficulty}</span>
      <span class="tag">{needsKit.length === 0 ? 'no equipment' : needsKit.join(', ')}</span>
    </p>
    <span class="card__meta">
      <PositionFigure position={startPosition} variant="inline" />
      <EvidenceBadge ref={evidenceLabel} />
    </span>
  </a>
</li>

<style>
  .card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    align-items: center;
  }
  .card__traditional {
    margin: 0;
    font-style: italic;
    color: var(--c-text-muted);
    font-size: var(--f-size-sm);
  }
  h3 {
    margin: 0;
  }
</style>
