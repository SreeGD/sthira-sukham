---
/*
 * Where in the leg a structure sits.
 *
 * One authored drawing serves all 19 muscle pages: the zone to highlight comes from
 * the content record's `diagramZone`, so adding a muscle needs no new artwork and no
 * component change (Principle III). Front and back views both render because half
 * the structures here are posterior and a front-only figure would misplace them.
 *
 * Deliberately schematic. It answers "roughly where is this" — which is what a reader
 * with no anatomy background needs — and does not pretend to be an anatomical plate.
 */

import type { DiagramZone } from '../../lib/diagram-zones.ts';

interface Props {
  /** One zone (a muscle page) or several (where an exercise should be felt). */
  zone: DiagramZone | DiagramZone[];
  /** Structure or exercise name, for the accessible description. */
  name: string;
  /** Overrides the caption when several zones are lit. */
  caption?: string;
}
const { zone, name, caption } = Astro.props;
const zones: DiagramZone[] = Array.isArray(zone) ? zone : [zone];

const SHAPES: Record<DiagramZone, { view: 'front' | 'back'; d: string; plain: string }> = {
  'hip-front': {
    view: 'front',
    d: 'M 50 26 Q 50 20 56 20 L 96 20 Q 102 20 102 26 L 102 62 L 50 62 Z',
    plain: 'the front of the hip',
  },
  /*
   * Lateral is on the LEFT of the front figure (thigh-outer) and therefore on the
   * RIGHT of the back figure — viewed from behind, the sides swap. Getting this
   * backwards puts the glutes and IT band on opposite sides of the same leg.
   */
  'hip-side': {
    view: 'back',
    d: 'M 236 20 L 244 20 Q 250 20 250 26 L 250 62 L 236 62 Z',
    plain: 'the side of the hip',
  },
  'hip-back': {
    view: 'back',
    d: 'M 198 26 Q 198 20 204 20 L 236 20 L 236 62 L 198 62 Z',
    plain: 'the buttock',
  },
  'thigh-front': {
    view: 'front',
    d: 'M 68 64 L 84 64 L 82 168 L 70 168 Z',
    plain: 'the front of the thigh',
  },
  'thigh-inner': {
    view: 'front',
    d: 'M 84 64 L 101 64 L 94 168 L 82 168 Z',
    plain: 'the inner thigh',
  },
  'thigh-outer': {
    view: 'front',
    d: 'M 51 64 L 68 64 L 70 168 L 58 168 Z',
    plain: 'the outer thigh',
  },
  'thigh-back': {
    view: 'back',
    d: 'M 199 64 L 249 64 L 242 168 L 206 168 Z',
    plain: 'the back of the thigh',
  },
  'knee-front': {
    view: 'front',
    d: 'M 58 170 L 94 170 Q 98 170 98 176 L 98 196 Q 98 202 94 202 L 58 202 Q 54 202 54 196 L 54 176 Q 54 170 58 170 Z',
    plain: 'the front of the knee',
  },
  'knee-back': {
    view: 'back',
    d: 'M 206 170 L 242 170 Q 246 170 246 176 L 246 196 Q 246 202 242 202 L 206 202 Q 202 202 202 196 L 202 176 Q 202 170 206 170 Z',
    plain: 'behind the knee',
  },
  calf: {
    view: 'back',
    d: 'M 206 204 L 242 204 Q 247 216 244 242 L 235 286 L 214 286 Q 203 242 206 204 Z',
    plain: 'the calf',
  },
  shin: {
    view: 'front',
    d: 'M 68 204 L 94 204 L 87 286 L 72 286 Z',
    plain: 'the front of the shin',
  },
  'lower-leg-outer': {
    view: 'front',
    d: 'M 58 204 L 68 204 L 72 286 L 66 286 Z',
    plain: 'the outer side of the lower leg',
  },
  foot: {
    view: 'front',
    d: 'M 66 288 L 87 288 L 106 302 L 66 302 Z',
    plain: 'the sole of the foot',
  },
};

const cls = (z: DiagramZone) => (zones.includes(z) ? 'leg-zone is-active' : 'leg-zone');

/** Join the plain-language names so the caption reads as a sentence, never as ids. */
const plainList = zones.map((z) => SHAPES[z].plain);
const plain =
  plainList.length === 1
    ? plainList[0]!
    : plainList.slice(0, -1).join(', ') + ' and ' + plainList[plainList.length - 1];
const captionText = caption ?? plain.charAt(0).toUpperCase() + plain.slice(1);
---

<figure class="diagram diagram--locator">
  <svg viewBox="0 0 300 320" role="img" aria-labelledby="loc-title loc-desc" class="diagram__svg">
    <title id="loc-title">Where {name} sits</title>
    <desc id="loc-desc">
      Simplified front and back views of a leg, with {plain} highlighted.
    </desc>

    <g aria-hidden="true">
      <!-- Structural outlines that are never highlighted -->
      <path d="M 214 288 L 235 288 L 254 302 L 214 302 Z" class="leg-base" />

      {Object.entries(SHAPES).map(([id, s]) => <path d={s.d} class={cls(id as DiagramZone)} />)}

      <text x="76" y="316" class="leg-view" text-anchor="middle">front</text>
      <text x="224" y="316" class="leg-view" text-anchor="middle">back</text>
    </g>
  </svg>

  <figcaption>
    <span class="leg-badge">
      <span aria-hidden="true">◆</span>
      {captionText}
    </span>
  </figcaption>
</figure>

<style>
  .diagram {
    margin: 0 0 var(--s-5);
    padding: var(--s-4);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    background: var(--c-diagram-bg);
  }
  .diagram--locator {
    max-width: 20rem;
  }
  .diagram__svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .leg-base,
  .leg-zone {
    fill: var(--c-diagram-fill);
    stroke: var(--c-diagram-stroke);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  /* The highlight is carried by fill AND a heavier stroke, and the caption names the
     location in words — so it survives greyscale and a colour-blind reader (SC-011). */
  .leg-zone.is-active {
    fill: var(--c-diagram-active-fill);
    stroke: var(--c-diagram-active);
    stroke-width: 3.5;
  }
  .leg-view {
    fill: var(--c-diagram-label);
    font-size: 12px;
    font-family: var(--f-body);
  }

  figcaption {
    margin-top: var(--s-2);
    text-align: center;
  }
  .leg-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    font-size: var(--f-size-sm);
    font-weight: 600;
    color: var(--c-text);
  }
  .leg-badge [aria-hidden] {
    color: var(--c-diagram-active);
  }
</style>
