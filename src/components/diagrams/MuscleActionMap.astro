---
import { getCollection } from 'astro:content';
import type { DiagramZone } from '../../lib/diagram-zones.ts';

/*
 * One picture of the whole system: every catalogued structure, where it sits, and what
 * it does to the knee.
 *
 * Content-driven where it can be. Muscle names per zone are read from the collection,
 * so adding a muscle updates this map with no edit here. Only the label anchors and the
 * one-line action summaries are authored, because those need hand-placing and editorial
 * judgement respectively.
 *
 * The point it exists to make is the one that runs through the whole reference: most of
 * what governs a knee is not at the knee. Six of the ten zones are hip or ankle.
 */

const muscles = (await getCollection('muscles')).sort((a, b) => a.data.order - b.data.order);

interface ZoneSpec {
  zone: DiagramZone;
  /** Short group name shown on the figure. Two or three words maximum. */
  group: string;
  /** What this group does to the knee, in one line. */
  action: string;
  /** Whether the structure acts on the knee directly or via another joint. */
  reach: 'direct' | 'referred';
  /* Numbered marker position, and where its leader touches the figure.
     Numbers, not words: SVG text does not wrap and clips silently past the viewBox,
     which is exactly how the first version of this diagram failed. The words live in
     the HTML legend below, where they reflow and scale. */
  marker: [number, number];
  leader: [number, number, number, number];
}

const ZONES: ZoneSpec[] = [
  {
    zone: 'hip-front',
    group: 'Hip flexors',
    action: 'Bends the hip. Tight, and you stand with a bent knee all day.',
    reach: 'referred',
    marker: [126, 44],
    leader: [138, 44, 258, 44],
  },
  {
    zone: 'thigh-front',
    group: 'Quadriceps',
    action: 'Straightens the knee.',
    reach: 'direct',
    marker: [126, 92],
    leader: [138, 92, 280, 108],
  },
  {
    zone: 'thigh-inner',
    group: 'Adductors',
    action: 'Draws the thigh in. Tight, and the knee falls inward under load.',
    reach: 'referred',
    marker: [126, 134],
    leader: [138, 134, 294, 130],
  },
  {
    zone: 'thigh-outer',
    group: 'IT band',
    action: 'Transmits hip tension to the outer knee.',
    reach: 'referred',
    marker: [126, 176],
    leader: [138, 176, 266, 140],
  },
  {
    zone: 'knee-front',
    group: 'Capsule',
    action: 'Passive tissue. Restricts range; cannot be strengthened.',
    reach: 'direct',
    marker: [126, 220],
    leader: [138, 220, 270, 190],
  },
  {
    zone: 'hip-back',
    group: 'Glute max',
    action: 'Straightens the hip. Weak, and the hamstrings take over.',
    reach: 'referred',
    marker: [500, 44],
    leader: [488, 44, 458, 40],
  },
  {
    zone: 'hip-side',
    group: 'Glute med/min',
    action: 'Holds the pelvis level. Weak, and the thigh rolls inward.',
    reach: 'referred',
    marker: [500, 86],
    leader: [488, 86, 462, 52],
  },
  {
    zone: 'thigh-back',
    group: 'Hamstrings',
    action: 'Bends the knee. Tight, and it will not straighten fully.',
    reach: 'direct',
    marker: [500, 130],
    leader: [488, 130, 446, 112],
  },
  {
    zone: 'knee-back',
    group: 'Popliteus',
    action: 'Unlocks a fully straight knee so it can start bending.',
    reach: 'direct',
    marker: [500, 178],
    leader: [488, 178, 460, 188],
  },
  {
    zone: 'calf',
    group: 'Calf',
    action: 'Points the foot. Tight, and the shin cannot travel forward.',
    reach: 'referred',
    marker: [500, 232],
    leader: [488, 232, 454, 236],
  },
];

/** Shapes mirror LegLocator's, shifted right to leave room for labels either side. */
const DX = 208;
const SHAPES: Record<DiagramZone, string> = {
  'hip-front': `M ${50 + DX} 26 Q ${50 + DX} 20 ${56 + DX} 20 L ${96 + DX} 20 Q ${102 + DX} 20 ${102 + DX} 26 L ${102 + DX} 62 L ${50 + DX} 62 Z`,
  'thigh-front': `M ${68 + DX} 64 L ${84 + DX} 64 L ${82 + DX} 168 L ${70 + DX} 168 Z`,
  'thigh-inner': `M ${84 + DX} 64 L ${101 + DX} 64 L ${94 + DX} 168 L ${82 + DX} 168 Z`,
  'thigh-outer': `M ${51 + DX} 64 L ${68 + DX} 64 L ${70 + DX} 168 L ${58 + DX} 168 Z`,
  'knee-front': `M ${58 + DX} 170 L ${94 + DX} 170 Q ${98 + DX} 170 ${98 + DX} 176 L ${98 + DX} 196 Q ${98 + DX} 202 ${94 + DX} 202 L ${58 + DX} 202 Q ${54 + DX} 202 ${54 + DX} 196 L ${54 + DX} 176 Q ${54 + DX} 170 ${58 + DX} 170 Z`,
  'hip-side': `M ${236 + DX} 20 L ${244 + DX} 20 Q ${250 + DX} 20 ${250 + DX} 26 L ${250 + DX} 62 L ${236 + DX} 62 Z`,
  'hip-back': `M ${198 + DX} 26 Q ${198 + DX} 20 ${204 + DX} 20 L ${236 + DX} 20 L ${236 + DX} 62 L ${198 + DX} 62 Z`,
  'thigh-back': `M ${199 + DX} 64 L ${249 + DX} 64 L ${242 + DX} 168 L ${206 + DX} 168 Z`,
  'knee-back': `M ${206 + DX} 170 L ${242 + DX} 170 Q ${246 + DX} 170 ${246 + DX} 176 L ${246 + DX} 196 Q ${246 + DX} 202 ${242 + DX} 202 L ${206 + DX} 202 Q ${202 + DX} 202 ${202 + DX} 196 L ${202 + DX} 176 Q ${202 + DX} 170 ${206 + DX} 170 Z`,
  calf: `M ${206 + DX} 204 L ${242 + DX} 204 Q ${247 + DX} 216 ${244 + DX} 242 L ${235 + DX} 286 L ${214 + DX} 286 Q ${203 + DX} 242 ${206 + DX} 204 Z`,
};

const BASE = [
  `M ${58 + DX} 204 L ${94 + DX} 204 L ${87 + DX} 286 L ${66 + DX} 286 Z`,
  `M ${66 + DX} 288 L ${87 + DX} 288 L ${106 + DX} 302 L ${66 + DX} 302 Z`,
  `M ${214 + DX} 288 L ${235 + DX} 288 L ${254 + DX} 302 L ${214 + DX} 302 Z`,
];

const inZone = (zone: DiagramZone) => muscles.filter((m) => m.data.diagramZone === zone);
const referredCount = ZONES.filter((z) => z.reach === 'referred').length;
---

<figure class="diagram action-map">
  <svg viewBox="0 0 620 332" role="img" aria-labelledby="map-title map-desc" class="diagram__svg">
    <title id="map-title">What each muscle group does to the knee</title>
    <desc id="map-desc">
      Front and back views of a leg with ten regions labelled. The front shows the hip flexors,
      the front, inner and outer thigh, and the front of the knee. The back shows the buttock,
      the side of the hip, the back of the thigh, behind the knee, and the calf. Each label
      states what that group does to the knee. Six of the ten act on the knee indirectly, through
      the hip or the ankle. The same information is listed as text below the diagram.
    </desc>

    <g aria-hidden="true">
      {BASE.map((d) => <path d={d} class="map-base" />)}
      {
        ZONES.map((z) => (
          <path d={SHAPES[z.zone]} class={`map-zone map-zone--${z.reach}`} />
        ))
      }
      {
        ZONES.map((z, i) => (
          <>
            <line x1={z.leader[0]} y1={z.leader[1]} x2={z.leader[2]} y2={z.leader[3]} class="map-leader" />
            <circle cx={z.marker[0]} cy={z.marker[1]} r="12" class="map-marker" />
            <text
              x={z.marker[0]}
              y={z.marker[1]}
              class="map-num"
              text-anchor="middle"
              dominant-baseline="central"
            >
              {i + 1}
            </text>
            <text
              x={z.marker[0] < 300 ? z.marker[0] - 17 : z.marker[0] + 17}
              y={z.marker[1]}
              class="map-group"
              text-anchor={z.marker[0] < 300 ? 'end' : 'start'}
              dominant-baseline="central"
            >
              {z.group}
            </text>
          </>
        ))
      }
      <text x={76 + DX} y="320" class="map-view" text-anchor="middle">front</text>
      <text x={224 + DX} y="320" class="map-view" text-anchor="middle">back</text>
    </g>
  </svg>

  <figcaption>
    <p class="map-lede">
      <strong>Six of these ten act on the knee indirectly</strong>, through the hip or the ankle.
      That is why so much of this reference is about muscles that are nowhere near the joint that
      hurts.
    </p>

    <ol class="map-key">
      {
        ZONES.map((z, i) => {
          const members = inZone(z.zone);
          return (
            <li>
              <span class="map-key__num" aria-hidden="true">
                {i + 1}
              </span>
              <span class={`map-key__dot map-key__dot--${z.reach}`} aria-hidden="true" />
              <span>
                <strong>{z.group}.</strong> {z.action}{' '}
                <span class="map-key__reach">
                  {z.reach === 'direct' ? 'Acts on the knee directly.' : 'Acts through another joint.'}
                </span>
                <br />
                {members.map((m, i) => (
                  <>
                    {i > 0 && ', '}
                    <a href={`/muscles/${m.id}/`}>{m.data.anatomicalName}</a>
                  </>
                ))}
              </span>
            </li>
          );
        })
      }
    </ol>
    <p class="map-note">
      Solid regions act on the knee directly; hatched regions act through the hip or the ankle
      ({referredCount} of {ZONES.length}).
    </p>
  </figcaption>
</figure>

<style>
  .diagram {
    margin: 0 0 var(--s-6);
    padding: var(--s-4);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    background: var(--c-diagram-bg);
  }
  .diagram__svg {
    display: block;
    width: 100%;
    height: auto;
    /* Wide and label-heavy: it needs its own overflow container on small screens
       rather than shrinking the text to illegibility (SC-014). */
    min-width: 34rem;
  }
  .action-map .diagram__svg {
    margin-inline: auto;
  }
  .action-map {
    overflow-x: auto;
  }

  .map-base {
    fill: var(--c-diagram-fill);
    stroke: var(--c-diagram-stroke);
    stroke-width: 1.5;
    opacity: 0.6;
  }
  .map-zone {
    stroke: var(--c-diagram-active);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  /* Direct vs referred is carried by fill pattern, not colour: solid versus hatched
     survives greyscale (SC-011), and the caption states it in words too. */
  .map-zone--direct {
    fill: var(--c-diagram-active-fill);
  }
  .map-zone--referred {
    fill: var(--c-diagram-fill);
    stroke-dasharray: 5 3;
  }
  .map-leader {
    stroke: var(--c-diagram-stroke);
    stroke-width: 1.25;
  }
  .map-marker {
    fill: var(--c-diagram-bg);
    stroke: var(--c-diagram-active);
    stroke-width: 2.5;
  }
  .map-group {
    fill: var(--c-diagram-label);
    font-size: 13px;
    font-weight: 600;
    font-family: var(--f-body);
  }
  .map-num {
    fill: var(--c-diagram-active);
    font-size: 13px;
    font-weight: 700;
    font-family: var(--f-body);
  }
  .map-view {
    fill: var(--c-diagram-label);
    font-size: 12px;
    font-family: var(--f-body);
  }

  .map-lede {
    margin: var(--s-4) 0 var(--s-4);
    max-width: var(--measure);
  }
  .map-key {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--s-3);
    font-size: var(--f-size-sm);
    max-width: var(--measure);
  }
  .map-key li {
    display: flex;
    gap: var(--s-3);
    align-items: flex-start;
  }
  .map-key li + li {
    margin-top: var(--s-3);
  }
  .map-key__num {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    display: grid;
    place-items: center;
    border: 2px solid var(--c-diagram-active);
    border-radius: 50%;
    color: var(--c-diagram-active);
    font-weight: 700;
    font-size: var(--f-size-xs);
  }
  .map-key__dot {
    flex: none;
    width: 0.9rem;
    height: 0.9rem;
    margin-top: 0.3em;
    border: 2px solid var(--c-diagram-active);
    border-radius: 3px;
  }
  .map-key__dot--direct {
    background: var(--c-diagram-active-fill);
  }
  .map-key__dot--referred {
    background: transparent;
    border-style: dashed;
  }
  .map-key__reach {
    color: var(--c-text-muted);
  }
  .map-note {
    margin: 0;
    font-size: var(--f-size-sm);
    color: var(--c-text-muted);
  }
</style>
