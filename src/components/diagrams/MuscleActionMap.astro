---
import { withBase } from '../../lib/paths.ts';
import { getCollection } from 'astro:content';
import type { DiagramZone } from '../../lib/diagram-zones.ts';

/*
 * One picture of the whole system: every catalogued structure, where it sits, and what
 * it does to the knee.
 *
 * Content-driven where it can be. Muscle names per zone are read from the collection,
 * so adding a muscle updates this map with no edit here. Only the label anchors and the
 * one-line action summaries are authored, because those need hand-placing and editorial
 * judgement respectively.
 *
 * The point it exists to make is the one that runs through the whole reference: most of
 * what governs a knee is not at the knee. Six of the ten zones are hip or ankle.
 */

type Joint = 'knee' | 'hip' | 'ankle' | 'foot';

interface Props {
  /** Which joint to draw the map for. Defaults to the knee. */
  joint?: Joint;
}
const { joint = 'knee' } = Astro.props;

const allMuscles = (await getCollection('muscles')).sort((a, b) => a.data.order - b.data.order);

/*
 * A structure appears on this map only if it influences THIS joint, and its action
 * marker comes from that influence — so the same structure can be solid on one joint's
 * map and hatched on another's. Drawing the knee's regions on the ankle page would
 * assert relationships the content never claimed.
 */
const influenceAt = (m: (typeof allMuscles)[number]) =>
  m.data.jointInfluences.find((i) => i.joint.id === joint);
const muscles = allMuscles.filter((m) => influenceAt(m));

const jointEntry = (await getCollection('joints')).find((j) => j.id === joint)!;

interface ZoneSpec {
  zone: DiagramZone;
  /*
   * Label and action are per joint, because neither transfers. Only rectus femoris of
   * the quadriceps crosses the hip, so labelling the front-of-thigh region
   * "Quadriceps" on the hip map claims three muscles act there that do not. And a
   * group's action at the knee says nothing about what it does at the hip.
   */
  group: Partial<Record<Joint, string>> & { knee: string };
  action: Partial<Record<Joint, string>> & { knee: string };
  reach: 'direct' | 'referred';
  /* Numbered marker position, and where its leader touches the figure.
     Numbers, not words: SVG text does not wrap and clips silently past the viewBox,
     which is exactly how the first version of this diagram failed. The words live in
     the HTML legend below, where they reflow and scale. */
  marker: [number, number];
  leader: [number, number, number, number];
}

const ZONES: ZoneSpec[] = [
  {
    zone: 'hip-front',
    group: { knee: 'Hip flexors', hip: 'Hip flexors' },
    action: { knee: "Bends the hip. Tight, and you stand with a bent knee all day.", hip: "Bends the hip. Tight, and the hip will not straighten fully." },
    reach: 'referred',
    marker: [218, 44],
    leader: [230, 44, 350, 44],
  },
  {
    zone: 'thigh-front',
    group: { knee: 'Quadriceps', hip: 'Rectus femoris' },
    action: { knee: "Straightens the knee.", hip: "The one quadriceps head that crosses the hip and helps bend it." },
    reach: 'direct',
    marker: [218, 92],
    leader: [230, 92, 372, 108],
  },
  {
    zone: 'thigh-inner',
    group: { knee: 'Inner quad · adductors', hip: 'Adductors' },
    action: { knee: "Draws the thigh in. Tight, and the knee falls inward under load.", hip: "Draw the thigh inward. Tight, and the leg will not move far out to the side." },
    reach: 'referred',
    marker: [218, 134],
    leader: [230, 134, 386, 130],
  },
  {
    zone: 'thigh-outer',
    group: { knee: 'Outer quad · IT band', hip: 'IT band' },
    action: { knee: "Transmits hip tension to the outer knee.", hip: "Carries tension generated at the hip down the outer thigh." },
    reach: 'referred',
    marker: [218, 176],
    leader: [230, 176, 358, 140],
  },
  {
    zone: 'knee-front',
    group: { knee: 'Capsule · retinaculum' },
    action: { knee: "Passive tissue. Restricts range; cannot be strengthened." },
    reach: 'direct',
    marker: [218, 220],
    leader: [230, 220, 362, 190],
  },
  {
    zone: 'hip-back',
    group: { knee: 'Glute max', hip: 'Glute max · deep rotators' },
    action: { knee: "Straightens the hip. Weak, and the hamstrings take over.", hip: "Straighten the hip and turn the thigh outward." },
    reach: 'referred',
    marker: [592, 44],
    leader: [580, 44, 550, 40],
  },
  {
    zone: 'hip-side',
    group: { knee: 'Glute med/min', hip: 'Glute med/min · TFL' },
    action: { knee: "Holds the pelvis level. Weak, and the thigh rolls inward.", hip: "Hold the pelvis level when you stand on one leg." },
    reach: 'referred',
    marker: [592, 86],
    leader: [580, 86, 554, 52],
  },
  {
    zone: 'thigh-back',
    group: { knee: 'Hamstrings', hip: 'Hamstrings' },
    action: { knee: "Bends the knee. Tight, and it will not straighten fully.", hip: "Extend the hip. Tight, and the pelvis tips backward when you bend forward." },
    reach: 'direct',
    marker: [592, 130],
    leader: [580, 130, 538, 112],
  },
  {
    zone: 'knee-back',
    group: { knee: 'Popliteus' },
    action: { knee: "Unlocks a fully straight knee so it can start bending." },
    reach: 'direct',
    marker: [592, 178],
    leader: [580, 178, 552, 188],
  },
  {
    zone: 'shin',
    group: { knee: 'Shin', ankle: 'Shin', foot: 'Toe lifters' },
    action: { knee: "Lifts the foot. Weak, and the toes catch as the leg swings through.", ankle: "Lifts the foot. Weak, and the toes catch as the leg swings through.", foot: "Lift the toes. Prominent and cordy when they are covering for a weak shin." },
    reach: 'direct',
    marker: [218, 262],
    leader: [230, 262, 360, 250],
  },
  {
    zone: 'lower-leg-outer',
    group: { knee: 'Outer lower leg', ankle: 'Outer lower leg', foot: 'Outer lower leg' },
    action: { knee: "Stops the ankle rolling over. Slow to respond after a sprain.", ankle: "Stops the ankle rolling over. Slow to respond after a sprain.", foot: "Anchors the inner edge of the foot down so the big toe can take load." },
    reach: 'direct',
    marker: [592, 262],
    leader: [580, 262, 374, 250],
  },
  {
    zone: 'foot',
    group: { knee: 'Sole of the foot', ankle: 'Sole of the foot', foot: 'Arch and sole' },
    action: { knee: "Stiffens the foot into a lever for push-off.", ankle: "Stiffens the foot into a lever for push-off.", foot: "Hold the arch up — actively by muscle, passively by the fascia." },
    reach: 'direct',
    marker: [218, 296],
    leader: [230, 296, 360, 296],
  },
  {
    zone: 'calf',
    group: { knee: 'Calf', ankle: 'Calf', foot: 'Calf and deep toe flexor' },
    action: { knee: "Points the foot. Tight, and the shin cannot travel forward.", ankle: "Points the foot down. Tight, and the shin cannot travel forward over it.", foot: "Tight, and the heel lifts early — loading the big toe for longer than it should carry." },
    reach: 'referred',
    marker: [592, 232],
    leader: [580, 232, 546, 236],
  },
  {
    zone: 'ankle',
    group: { knee: 'Ankle joint', ankle: 'Ankle joint', foot: 'Ankle joint' },
    action: { knee: "Passive tissue. Restricts how far the shin can travel forward.", ankle: "Passive tissue. Restricts dorsiflexion whether the knee is bent or straight.", foot: "Sits behind the foot. Restriction here changes how the foot is loaded." },
    reach: 'direct',
    marker: [218, 282],
    leader: [230, 282, 358, 286],
  },
  {
    zone: 'toes',
    group: { knee: 'Big toe joint', ankle: 'Big toe joint', foot: 'Big toe joint' },
    action: { knee: "Where the foot rolls off at the end of every step.", ankle: "Where the foot rolls off at the end of every step.", foot: "Bends up ~65° at push-off. Lose it and the foot rolls off its inner edge." },
    reach: 'direct',
    marker: [592, 300],
    leader: [580, 300, 402, 304],
  },
];

/** Shapes mirror LegLocator's, shifted right to leave room for labels either side. */
const DX = 300;
const SHAPES: Record<DiagramZone, string> = {
  'hip-front': `M ${50 + DX} 26 Q ${50 + DX} 20 ${56 + DX} 20 L ${96 + DX} 20 Q ${102 + DX} 20 ${102 + DX} 26 L ${102 + DX} 62 L ${50 + DX} 62 Z`,
  'thigh-front': `M ${68 + DX} 64 L ${84 + DX} 64 L ${82 + DX} 168 L ${70 + DX} 168 Z`,
  'thigh-inner': `M ${84 + DX} 64 L ${101 + DX} 64 L ${94 + DX} 168 L ${82 + DX} 168 Z`,
  'thigh-outer': `M ${51 + DX} 64 L ${68 + DX} 64 L ${70 + DX} 168 L ${58 + DX} 168 Z`,
  'knee-front': `M ${58 + DX} 170 L ${94 + DX} 170 Q ${98 + DX} 170 ${98 + DX} 176 L ${98 + DX} 196 Q ${98 + DX} 202 ${94 + DX} 202 L ${58 + DX} 202 Q ${54 + DX} 202 ${54 + DX} 196 L ${54 + DX} 176 Q ${54 + DX} 170 ${58 + DX} 170 Z`,
  ankle: `M ${67 + DX} 280 L ${88 + DX} 280 L ${89 + DX} 294 L ${66 + DX} 294 Z`,
  toes: `M ${98 + DX} 298 L ${112 + DX} 298 Q ${117 + DX} 304 ${112 + DX} 310 L ${98 + DX} 310 Z`,
  'hip-side': `M ${236 + DX} 20 L ${244 + DX} 20 Q ${250 + DX} 20 ${250 + DX} 26 L ${250 + DX} 62 L ${236 + DX} 62 Z`,
  'hip-back': `M ${198 + DX} 26 Q ${198 + DX} 20 ${204 + DX} 20 L ${236 + DX} 20 L ${236 + DX} 62 L ${198 + DX} 62 Z`,
  'thigh-back': `M ${199 + DX} 64 L ${249 + DX} 64 L ${242 + DX} 168 L ${206 + DX} 168 Z`,
  'knee-back': `M ${206 + DX} 170 L ${242 + DX} 170 Q ${246 + DX} 170 ${246 + DX} 176 L ${246 + DX} 196 Q ${246 + DX} 202 ${242 + DX} 202 L ${206 + DX} 202 Q ${202 + DX} 202 ${202 + DX} 196 L ${202 + DX} 176 Q ${202 + DX} 170 ${206 + DX} 170 Z`,
  calf: `M ${206 + DX} 204 L ${242 + DX} 204 Q ${247 + DX} 216 ${244 + DX} 242 L ${235 + DX} 286 L ${214 + DX} 286 Q ${203 + DX} 242 ${206 + DX} 204 Z`,
  shin: `M ${68 + DX} 204 L ${94 + DX} 204 L ${88 + DX} 278 L ${73 + DX} 278 Z`,
  'lower-leg-outer': `M ${58 + DX} 204 L ${68 + DX} 204 L ${73 + DX} 278 L ${67 + DX} 278 Z`,
  foot: `M ${66 + DX} 296 L ${89 + DX} 296 L ${98 + DX} 310 L ${66 + DX} 310 Z`,
};

const BASE = [`M ${214 + DX} 288 L ${235 + DX} 288 L ${254 + DX} 310 L ${214 + DX} 310 Z`];

const inZone = (zone: DiagramZone) => muscles.filter((m) => m.data.diagramZone === zone);

/* Only zones with a structure influencing this joint are drawn. */
const jointName = jointEntry.data.name.toLowerCase();
const label = (z: ZoneSpec) => z.group[joint] ?? z.group.knee;
const actionText = (z: ZoneSpec) => z.action[joint] ?? z.action.knee;

const activeZones = ZONES.filter((z) => inZone(z.zone).length > 0).map((z) => {
  const members = inZone(z.zone);
  /*
   * A zone can hold structures that reach this joint differently, and collapsing that to
   * one verdict overstates it. On the foot map the calf zone holds two structures that act
   * directly and three that act through the ankle; calling the whole zone "direct" claimed
   * a relationship the content never made for gastrocnemius, soleus or the Achilles.
   * Mixed zones are drawn solid — something there is direct — but say so in words.
   */
  const direct = members.filter((m) => influenceAt(m)!.action === 'direct').length;
  const reach = direct === 0 ? 'referred' : direct === members.length ? 'direct' : 'mixed';
  return { ...z, reach: reach as 'direct' | 'referred' | 'mixed', direct };
});
const referredCount = activeZones.filter((z) => z.reach === 'referred').length;
/* Zones holding at least one structure that reaches this joint through another. Distinct
   from referredCount, which is only the fully-indirect zones (the ones drawn hatched).
   Using referredCount in prose claimed "everything here acts directly" on the ankle and
   foot maps while a mixed zone sat in the legend saying otherwise. */
const zonesWithIndirect = activeZones.filter((z) => z.reach !== 'direct').length;

/* Names of the regions actually drawn, for the accessible description. Derived, because
   the hardcoded version described the knee's ten regions on every joint's map — including
   the foot's, which draws five and shares none of the wording. */
/* Lowercase the first letter only. A blanket toLowerCase() turned "Outer quad · IT band"
   into "it band" and "Glute med/min · TFL" into "tfl". */
const zoneNames = activeZones.map((z) => {
  const l = label(z);
  // Leave it alone when the label opens with an acronym: "IT band" must not become
  // "iT band", and a blanket toLowerCase() made it "it band".
  const opensWithAcronym = /^[A-Z]{2}/.test(l);
  return opensWithAcronym ? l : l.charAt(0).toLowerCase() + l.slice(1);
});
const zoneNameList =
  zoneNames.length === 1
    ? zoneNames[0]
    : zoneNames.slice(0, -1).join(', ') + ' and ' + zoneNames[zoneNames.length - 1];
---

<figure class="diagram action-map">
  <svg viewBox="0 0 800 340" role="img" aria-labelledby="map-title map-desc" class="diagram__svg">
    <title id="map-title">What each muscle group does to {jointName}</title>
    <desc id="map-desc">
      Front and back views of a leg showing the {activeZones.length} regions that influence{' '}
      {jointName}: {zoneNameList}. Each label states what that group does to {jointName}.{' '}
      {zonesWithIndirect > 0
        ? `${zonesWithIndirect} of the ${activeZones.length} ${zonesWithIndirect === 1 ? 'contains a structure that acts' : 'contain structures that act'} on it indirectly, through a neighbouring joint.`
        : 'All of them act on it directly.'}{' '}
      The same information is listed as text below the diagram.
    </desc>

    <g aria-hidden="true">
      {BASE.map((d) => <path d={d} class="map-base" />)}
      {Object.values(SHAPES).map((d) => <path d={d} class="map-base" />)}
      {
        activeZones.map((z) => (
          <path d={SHAPES[z.zone]} class={`map-zone map-zone--${z.reach === 'referred' ? 'referred' : 'direct'}`} />
        ))
      }
      {
        activeZones.map((z, i) => (
          <>
            <line x1={z.leader[0]} y1={z.leader[1]} x2={z.leader[2]} y2={z.leader[3]} class="map-leader" />
            <circle cx={z.marker[0]} cy={z.marker[1]} r="12" class="map-marker" />
            <text
              x={z.marker[0]}
              y={z.marker[1]}
              class="map-num"
              text-anchor="middle"
              dominant-baseline="central"
            >
              {i + 1}
            </text>
            <text
              x={z.marker[0] < 300 ? z.marker[0] - 17 : z.marker[0] + 17}
              y={z.marker[1]}
              class="map-group"
              text-anchor={z.marker[0] < 300 ? 'end' : 'start'}
              dominant-baseline="central"
            >
              {label(z)}
            </text>
          </>
        ))
      }
      <text x={76 + DX} y="320" class="map-view" text-anchor="middle">front</text>
      <text x={224 + DX} y="320" class="map-view" text-anchor="middle">back</text>
    </g>
  </svg>

  <figcaption>
    <p class="map-lede">
      {
        zonesWithIndirect === 0 ? (
          <>
            Everything shown here acts on {jointEntry.data.name.toLowerCase()} directly. What it
            does to the joints <em>above</em> it is on each structure's own page — restriction
            here is felt further up the chain.
          </>
        ) : (
          <>
            <strong>
              {zonesWithIndirect} of these {activeZones.length}{' '}
              {zonesWithIndirect === 1 ? 'region reaches' : 'regions reach'} {jointName}{' '}
              indirectly
            </strong>, through a neighbouring joint. That is why so much of this reference is
            about muscles that are nowhere near the joint that hurts.
          </>
        )
      }
    </p>

    <ol class="map-key">
      {
        activeZones.map((z, i) => {
          const members = inZone(z.zone);
          return (
            <li>
              <span class="map-key__num" aria-hidden="true">
                {i + 1}
              </span>
              <span
                class={`map-key__dot map-key__dot--${z.reach === 'referred' ? 'referred' : 'direct'}`}
                aria-hidden="true"
              />
              <span>
                <strong>{label(z)}.</strong> {actionText(z)}{' '}
                <span class="map-key__reach">
                  {z.reach === 'direct'
                    ? `Acts on ${jointName} directly.`
                    : z.reach === 'referred'
                      ? 'Acts through another joint.'
                      : `${z.direct} of these ${z.direct === 1 ? 'acts' : 'act'} on ${jointName} directly; the rest act through a neighbouring joint.`}
                </span>
                <br />
                {members.map((m, i) => (
                  <>
                    {i > 0 && ', '}
                    <a href={withBase(`/muscles/${m.id}/`)}>{m.data.anatomicalName}</a>
                  </>
                ))}
              </span>
            </li>
          );
        })
      }
    </ol>
    <p class="map-note">
      Solid regions act on {jointEntry.data.name.toLowerCase()} directly; hatched regions act
      through a neighbouring joint ({referredCount} of {activeZones.length}).
    </p>
  </figcaption>
</figure>

<style>
  .diagram {
    margin: 0 0 var(--s-6);
    padding: var(--s-4);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    background: var(--c-diagram-bg);
  }
  .diagram__svg {
    display: block;
    width: 100%;
    height: auto;
    /* Wide and label-heavy: it needs its own overflow container on small screens
       rather than shrinking the text to illegibility (SC-014). */
    min-width: 34rem;
  }
  .action-map .diagram__svg {
    margin-inline: auto;
  }
  .action-map {
    overflow-x: auto;
  }

  .map-base {
    fill: var(--c-diagram-fill);
    stroke: var(--c-diagram-stroke);
    stroke-width: 1.5;
    opacity: 0.6;
  }
  .map-zone {
    stroke: var(--c-diagram-active);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  /* Direct vs referred is carried by fill pattern, not colour: solid versus hatched
     survives greyscale (SC-011), and the caption states it in words too. */
  .map-zone--direct {
    fill: var(--c-diagram-active-fill);
  }
  .map-zone--referred {
    fill: var(--c-diagram-fill);
    stroke-dasharray: 5 3;
  }
  .map-leader {
    stroke: var(--c-diagram-stroke);
    stroke-width: 1.25;
  }
  .map-marker {
    fill: var(--c-diagram-bg);
    stroke: var(--c-diagram-active);
    stroke-width: 2.5;
  }
  .map-group {
    fill: var(--c-diagram-label);
    font-size: 13px;
    font-weight: 600;
    font-family: var(--f-body);
  }
  .map-num {
    fill: var(--c-diagram-active);
    font-size: 13px;
    font-weight: 700;
    font-family: var(--f-body);
  }
  .map-view {
    fill: var(--c-diagram-label);
    font-size: 12px;
    font-family: var(--f-body);
  }

  .map-lede {
    margin: var(--s-4) 0 var(--s-4);
    max-width: var(--measure);
  }
  .map-key {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--s-3);
    font-size: var(--f-size-sm);
    max-width: var(--measure);
  }
  .map-key li {
    display: flex;
    gap: var(--s-3);
    align-items: flex-start;
  }
  .map-key li + li {
    margin-top: var(--s-3);
  }
  .map-key__num {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    display: grid;
    place-items: center;
    border: 2px solid var(--c-diagram-active);
    border-radius: 50%;
    color: var(--c-diagram-active);
    font-weight: 700;
    font-size: var(--f-size-xs);
  }
  .map-key__dot {
    flex: none;
    width: 0.9rem;
    height: 0.9rem;
    margin-top: 0.3em;
    border: 2px solid var(--c-diagram-active);
    border-radius: 3px;
  }
  .map-key__dot--direct {
    background: var(--c-diagram-active-fill);
  }
  .map-key__dot--referred {
    background: transparent;
    border-style: dashed;
  }
  .map-key__reach {
    color: var(--c-text-muted);
  }
  .map-note {
    margin: 0;
    font-size: var(--f-size-sm);
    color: var(--c-text-muted);
  }
</style>
